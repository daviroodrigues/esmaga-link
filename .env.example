# ==========================================
# APLICAÇÃO E REDE
# ==========================================
HOST_NGINX_PORT=80
APP_BASE_URL=http://localhost
PORT=8080
INSTANCE_ID=api-1

# Segurança e Geração de IDs
JWT_SECRET=troque-esta-chave-secreta-em-producao
ALPHABET_SEED=minha-seed-customizada-super-secreta-2026
ID_BATCH_SIZE=1000

# ==========================================
# POSTGRESQL (Auth e Templates de E-mail)
# ==========================================
POSTGRES_DB=esmaga_auth
POSTGRES_USER=esmaga_user
POSTGRES_PASSWORD=esmaga_secret
# Usado ao rodar API/Worker localmente fora do Docker:
POSTGRES_URL=postgres://esmaga_user:esmaga_secret@localhost:5432/esmaga_auth?sslmode=disable

# ==========================================
# CASSANDRA (Links e Analytics)
# ==========================================
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_KEYSPACE=esmaga_link

# ==========================================
# REDIS (Cache L2, Pub/Sub L1 e Rate Limit)
# ==========================================
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# ==========================================
# RABBITMQ (Cliques e Notificações)
# ==========================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Usado ao rodar API/Worker localmente fora do Docker:
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ==========================================
# E-MAIL TRANSACIONAL (SMTP Agnóstico)
# ==========================================
# Obrigatório: configure com seu provedor SMTP (SES, Resend, Brevo, Mailpit local, etc.).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Esmaga Link <noreply@esmagalink.local>
# Modos aceitos: none | starttls | tls
SMTP_TLS=tls

# ==========================================
# CLOUDFLARE TURNSTILE (Anti-Bot)
# ==========================================
# Deixe vazio para desabilitar a verificação em desenvolvimento.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================
# BACKUP AUTOMATIZADO
# ==========================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
